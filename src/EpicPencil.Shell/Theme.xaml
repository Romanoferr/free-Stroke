<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        Design System do Epic Pencil (tokens únicos — zero hex solto nas janelas).
        Superfície escura neutra + 1 accent. Modo nunca é comunicado só por cor.
    -->

    <!-- Cores -->
    <Color x:Key="SurfaceColor">#E6222222</Color>
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}"/>
    <SolidColorBrush x:Key="SurfaceStrokeBrush" Color="#1FFFFFFF"/>
    <SolidColorBrush x:Key="HairlineBrush" Color="#1FFFFFFF"/>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F2F2F2"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#A6A6A6"/>
    <SolidColorBrush x:Key="TextDisabledBrush" Color="#5A5A5A"/>
    <SolidColorBrush x:Key="HoverBrush" Color="#22FFFFFF"/>
    <SolidColorBrush x:Key="PressedBrush" Color="#33FFFFFF"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#6CB8F0"/>
    <SolidColorBrush x:Key="AccentBgBrush" Color="#1F6FB2"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#E5484D"/>
    <SolidColorBrush x:Key="ModeDrawBrush" Color="#4CC38A"/>
    <SolidColorBrush x:Key="ModeInteractBrush" Color="#F0A647"/>
    <SolidColorBrush x:Key="GripDotBrush" Color="#8A8A8A"/>

    <!-- Tooltip escuro (o tooltip claro do sistema some sobre fundo claro). -->
    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource SurfaceStrokeBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontFamily" Value="{StaticResource UiFontFamily}"/>
        <Setter Property="FontSize" Value="{StaticResource UiFontSize}"/>
        <Setter Property="Padding" Value="8,4"/>
        <Setter Property="HasDropShadow" Value="True"/>
    </Style>

    <!-- Tipografia -->
    <FontFamily x:Key="UiFontFamily">Segoe UI</FontFamily>
    <system:Double xmlns:system="clr-namespace:System;assembly=mscorlib"
                   x:Key="UiFontSize">12</system:Double>
    <system:Double xmlns:system="clr-namespace:System;assembly=mscorlib"
                   x:Key="SectionFontSize">10</system:Double>

    <!-- Forma -->
    <CornerRadius x:Key="CardCornerRadius">12</CornerRadius>
    <CornerRadius x:Key="ControlCornerRadius">8</CornerRadius>
    <system:Double xmlns:system="clr-namespace:System;assembly=mscorlib"
                   x:Key="ToolButtonWidth">40</system:Double>
    <system:Double xmlns:system="clr-namespace:System;assembly=mscorlib"
                   x:Key="ToolButtonHeight">36</system:Double>
    <system:Double xmlns:system="clr-namespace:System;assembly=mscorlib"
                   x:Key="IconSize">18</system:Double>
    <system:Double xmlns:system="clr-namespace:System;assembly=mscorlib"
                   x:Key="SwatchSize">22</system:Double>
</ResourceDictionary>
