<Window x:Class="EpicPencil.Shell.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:EpicPencil.Shell"
        Title="EpicPencil Overlay" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" Topmost="True" ShowInTaskbar="False"
        ResizeMode="NoResize" ShowActivated="False">
    <Grid>
        <!-- Piso de alfa 1/255: o hit-test do OS em janelas layered consulta o
             bitmap de alfa e perfura pixels alfa-zero mesmo com NCHITTEST=HTCLIENT
             e sem WS_EX_TRANSPARENT. Alfa 1 é invisível (<1 LSB) mas "sólido"
             para o compositor. Sem isso, canvas vazio nunca recebe cliques. -->
        <Border Background="#01000000"/>
        <local:InkSurface x:Name="Surface"/>
        <!-- Editor de texto (ferramenta Texto): visível só durante a edição.
             Posicionado via Margin em DIPs locais; fonte/cor/tamanho vêm do
             AppState ao abrir. Some sem deixar rastro (o texto vira DrawingVisual). -->
        <TextBox x:Name="TextEditor" Visibility="Collapsed"
                 HorizontalAlignment="Left" VerticalAlignment="Top"
                 MinWidth="40" MaxLength="1000" AcceptsReturn="False"
                 Background="#B0000000" BorderBrush="#66FFFFFF" BorderThickness="1"
                 Padding="2,0" CaretBrush="White"/>
        <!-- Badge de modo: prova visual de que o overlay existe + modo atual.
             Verde = desenho, vermelho = interagir. Requisito F-12 (indicador). -->
        <Ellipse x:Name="ModeBadge" Width="14" Height="14"
                 HorizontalAlignment="Right" VerticalAlignment="Top" Margin="12"
                 Fill="LimeGreen" Opacity="0.85"/>
        <!-- Painel de flash (diagnóstico): prova se a janela está visível e por cima. -->
        <Border x:Name="FlashPanel" Background="Red" Visibility="Collapsed"/>
    </Grid>
</Window>
