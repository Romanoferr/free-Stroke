<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\EpicPencil.Core\EpicPencil.Core.csproj" />
    <ProjectReference Include="..\EpicPencil.Windows\EpicPencil.Windows.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- Multi-monitor com DPI misto: cada overlay mede sua escala real
         (VisualTreeHelper.GetDpi) em vez de assumir o DPI do primário. -->
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
  </PropertyGroup>

</Project>
