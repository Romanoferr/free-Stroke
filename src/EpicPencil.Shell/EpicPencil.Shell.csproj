<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\EpicPencil.Core\EpicPencil.Core.csproj" />
    <ProjectReference Include="..\EpicPencil.Windows\EpicPencil.Windows.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Space Mono embutida (OFL — licença em Fonts/OFL.txt acompanha a cópia).
         Resource: vai dentro do assembly, sem depender do Windows do usuário. -->
    <Resource Include="Fonts\SpaceMono-Regular.ttf" />
    <Resource Include="Fonts\SpaceMono-Bold.ttf" />
    <Content Include="Fonts\OFL.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- Multi-monitor com DPI misto: cada overlay mede sua escala real
         (VisualTreeHelper.GetDpi) em vez de assumir o DPI do primário. -->
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <!-- Padrões de publicação (valem só no `dotnet publish`, nunca no
         build/run do dia a dia; RID e self-contained vêm do script
         scripts/publish-win-x64.ps1):
         - Single-file: 1 exe autocontido; recursos WPF (Resource/pack URI)
           continuam embutidos no assembly (validado via selftest).
         - Trimming DESLIGADO de propósito: WPF + reflection + P/Invoke
           exigem compatibilidade máxima (prioridade do projeto). -->
    <PublishSingleFile>true</PublishSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

</Project>
