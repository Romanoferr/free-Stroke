<Window x:Class="EpicPencil.Shell.ToolbarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Epic Pencil" Topmost="True" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        SizeToContent="WidthAndHeight" WindowStartupLocation="Manual"
        Left="16" Top="16" TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>

        <!-- Grip de arrasto compartilhado (barra recolhida + linha 1). -->
        <ControlTemplate x:Key="GripTemplate" TargetType="ContentControl">
            <StackPanel Orientation="Vertical" Background="{TemplateBinding Background}"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Ellipse Width="2.5" Height="2.5" Fill="{StaticResource GripDotBrush}" Margin="1.5"/>
                    <Ellipse Width="2.5" Height="2.5" Fill="{StaticResource GripDotBrush}" Margin="1.5"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Ellipse Width="2.5" Height="2.5" Fill="{StaticResource GripDotBrush}" Margin="1.5"/>
                    <Ellipse Width="2.5" Height="2.5" Fill="{StaticResource GripDotBrush}" Margin="1.5"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Ellipse Width="2.5" Height="2.5" Fill="{StaticResource GripDotBrush}" Margin="1.5"/>
                    <Ellipse Width="2.5" Height="2.5" Fill="{StaticResource GripDotBrush}" Margin="1.5"/>
                </StackPanel>
            </StackPanel>
        </ControlTemplate>
        <!-- Separador vertical entre grupos de ferramentas. -->
        <Style x:Key="VSeparator" TargetType="Border">
            <Setter Property="Width" Value="1"/>
            <Setter Property="Margin" Value="6,6,6,6"/>
            <Setter Property="Background" Value="{StaticResource HairlineBrush}"/>
        </Style>

        <!-- Botão-ícone 40x36: hover/pressed sutis; selected aplicado em código. -->
        <Style x:Key="ToolIconButton" TargetType="Button">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{StaticResource ControlCornerRadius}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource HoverBrush}"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{StaticResource PressedBrush}"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.4"/>
                    <Setter Property="Cursor" Value="Arrow"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- Botão fantasma pequeno (diagnóstico). -->
        <Style x:Key="GhostIconButton" TargetType="Button" BasedOn="{StaticResource ToolIconButton}">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        </Style>
        <!-- Pílula de texto (ações com rótulo). -->
        <Style x:Key="PillButton" TargetType="Button">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Background" Value="{StaticResource HoverBrush}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="FontFamily" Value="{StaticResource UiFontFamily}"/>
            <Setter Property="FontSize" Value="{StaticResource UiFontSize}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="15">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource PressedBrush}"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{StaticResource PressedBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- Variante danger (ações destrutivas): mesma forma, cor de perigo. -->
        <Style x:Key="PillButtonDanger" TargetType="Button" BasedOn="{StaticResource PillButton}">
            <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource DangerBrush}"/>
        </Style>
        <!-- Swatch de cor circular. -->
        <Style x:Key="SwatchButton" TargetType="Button">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="15" Padding="2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource HoverBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- Botão-ponto nu (dot de modo clicável na barra recolhida). -->
        <Style x:Key="DotButton" TargetType="Button">
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        </ResourceDictionary>
    </Window.Resources>

    <!-- Cartão flutuante: cantos arredondados, translúcido, sem chrome do OS. -->
    <Border Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource SurfaceStrokeBrush}" BorderThickness="1"
            CornerRadius="{StaticResource CardCornerRadius}" Padding="8,6,8,8">
        <StackPanel>
            <!-- Barra recolhida: grip + cor + ferramenta + modo + expandir. -->
            <Grid x:Name="CollapsedBar" Visibility="Collapsed" Height="34">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="26"/>
                    <ColumnDefinition Width="22"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="28"/>
                    <ColumnDefinition Width="32"/>
                </Grid.ColumnDefinitions>
                <ContentControl x:Name="CollapsedGrip" Grid.Column="0" Template="{StaticResource GripTemplate}"
                                Background="Transparent" Cursor="SizeAll" ToolTip="Arrastar toolbar"/>
                <Ellipse x:Name="CollapsedColorDot" Grid.Column="1" Width="12" Height="12" Fill="Red"/>
                <TextBlock x:Name="CollapsedToolText" Grid.Column="2" Text="Caneta"
                           Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" VerticalAlignment="Center" Margin="2,0"/>
                <!-- Dot clicável: alterna mostrar desenho / interagir com a barra recolhida. -->
                <Button x:Name="CollapsedModeButton" Grid.Column="3" Style="{StaticResource DotButton}"
                        Click="OnToggleInkMode" ToolTip="Mostrar/ocultar desenho (F9)">
                    <Ellipse x:Name="CollapsedModeDot" Width="10" Height="10" Fill="LimeGreen"/>
                </Button>
                <Button x:Name="ExpandButton" Grid.Column="4" Style="{StaticResource GhostIconButton}"
                        Click="OnToggleCollapse" ToolTip="Expandir ferramentas">
                    <Path Data="M5.5,9.5 L8,7 L10.5,9.5" Stroke="{StaticResource TextPrimaryBrush}" StrokeThickness="1.8"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent"/>
                </Button>
            </Grid>

            <!-- Painel expandido: 2 linhas compactas (sem header, sem labels de seção).
                 Linha 1: grip + ferramentas agrupadas + olho (modo) + recolher.
                 Linha 2: cor + espessura + histórico/destrutivas + contextual + sair. -->
            <StackPanel x:Name="ExpandedPanel">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ContentControl x:Name="HeaderGrip" Grid.Column="0" Template="{StaticResource GripTemplate}"
                                    Background="Transparent" Cursor="SizeAll" ToolTip="Arrastar toolbar"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button x:Name="SelectButton" Style="{StaticResource ToolIconButton}"
                                Click="OnToolSelect" ToolTip="Seleção / captura (V)">
                            <Path Data="M3.5,3.5 H12.5 V12.5 H3.5 Z" Stroke="{StaticResource TextPrimaryBrush}" StrokeThickness="1.5"
                                  StrokeDashArray="2.2 1.6" Fill="Transparent"/>
                        </Button>
                        <Border Style="{StaticResource VSeparator}"/>
                        <Button x:Name="PenButton" Style="{StaticResource ToolIconButton}"
                                Click="OnToolPen" ToolTip="Caneta (P)">
                            <Grid Width="18" Height="18">
                                <Path Data="M11,2.5 L13.5,5 L6.5,12 L3.5,13 L4,10 Z" Stroke="{StaticResource TextPrimaryBrush}"
                                      StrokeThickness="1.5" StrokeLineJoin="Round" Fill="Transparent"/>
                                <Ellipse Width="2" Height="2" Fill="{StaticResource TextPrimaryBrush}"
                                         HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="1,0,0,1"/>
                            </Grid>
                        </Button>
                        <Button x:Name="PencilButton" Style="{StaticResource ToolIconButton}"
                                Click="OnToolPencil" ToolTip="Lápis (B)">
                            <Path Data="M12.5,3.5 L11,5 L4.5,11.5 L3,13.5 L4.5,15 L6.5,13.5 L13,7 Z M10,6 L12,8"
                                  Stroke="{StaticResource TextPrimaryBrush}" StrokeThickness="1.5" StrokeLineJoin="Round" Fill="Transparent"/>
                        </Button>
                        <Button x:Name="MarkerButton" Style="{StaticResource ToolIconButton}"
                                Click="OnToolMarker" ToolTip="Marca-texto (H)">
                            <Path Data="M4,13 L11,3.5 L15,6.5 L8,16 L4.5,16.5 Z M9.5,6 L12,8"
                                  Stroke="{StaticResource TextPrimaryBrush}" StrokeThickness="1.5" StrokeLineJoin="Round" Fill="Transparent"/>
                        </Button>
                        <Button x:Name="EraserButton" Style="{StaticResource ToolIconButton}"
                                Click="OnToolEraser" ToolTip="Borracha (E)">
                            <Path Data="M6.5,11 L10,4.5 L14,8.5 L10.5,14.5 L5.5,14.5 Z M6.5,11 L10.5,14.5"
                                  Stroke="{StaticResource TextPrimaryBrush}" StrokeThickness="1.5" StrokeLineJoin="Round" Fill="Transparent"/>
                        </Button>
                        <Border Style="{StaticResource VSeparator}"/>
                        <Button x:Name="LineButton" Style="{StaticResource ToolIconButton}"
                                Click="OnToolLine" ToolTip="Linha (L)">
                            <Grid Width="18" Height="18">
                                <Path Data="M2.5,9 L13.5,9" Stroke="{StaticResource TextPrimaryBrush}" StrokeThickness="1.6"
                                      StrokeStartLineCap="Round"/>
                                <Ellipse Width="2.4" Height="2.4" Fill="{StaticResource TextPrimaryBrush}"
                                         HorizontalAlignment="Left" VerticalAlignment="Center" Margin="1,0,0,0"/>
                                <Ellipse Width="2.4" Height="2.4" Fill="{StaticResource TextPrimaryBrush}"
                                         HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,1,0"/>
                            </Grid>
                        </Button>
                        <Button x:Name="ArrowButton" Style="{StaticResource ToolIconButton}"
                                 Click="OnToolArrow" ToolTip="Seta (S)">
                            <Path Data="M2,9 L12,9 M8.5,5.5 L12,9 L8.5,12.5" Stroke="{StaticResource TextPrimaryBrush}"
                                   StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeLineJoin="Round"
                                   Fill="Transparent"/>
                        </Button>
                        <Button x:Name="RectangleButton" Style="{StaticResource ToolIconButton}"
                                 Click="OnToolRectangle" ToolTip="Retângulo (R)">
                            <Rectangle Width="12" Height="9" Stroke="{StaticResource TextPrimaryBrush}" StrokeThickness="1.6"
                                       Fill="Transparent"/>
                        </Button>
                        <Button x:Name="CircleButton" Style="{StaticResource ToolIconButton}"
                                 Click="OnToolCircle" ToolTip="Círculo (O)">
                            <Ellipse Width="12" Height="12" Stroke="{StaticResource TextPrimaryBrush}" StrokeThickness="1.6"
                                     Fill="Transparent"/>
                        </Button>
                        <Button x:Name="TextButton" Style="{StaticResource ToolIconButton}"
                                Click="OnToolText" ToolTip="Texto (T)">
                            <TextBlock Text="T" FontFamily="Segoe UI" FontWeight="SemiBold" FontSize="15"
                                       Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        </Button>
                    </StackPanel>
                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="HideButton" Style="{StaticResource ToolIconButton}"
                                Click="OnToggleInkMode" ToolTip="Mostrar desenho / ocultar e interagir (PgUp)">
                            <Grid Width="18" Height="18">
                                <Path x:Name="EyeOpenPath" Data="M1.5,9 C4,5.5 12,5.5 14.5,9 C12,12.5 4,12.5 1.5,9 Z"
                                      Stroke="{StaticResource TextPrimaryBrush}" StrokeThickness="1.5" StrokeLineJoin="Round" Fill="Transparent"/>
                                <Ellipse x:Name="EyePupil" Width="3.4" Height="3.4" Fill="{StaticResource TextPrimaryBrush}"/>
                                <Path x:Name="EyeClosedPath" Data="M2,6.5 C5,10 13,10 16,6.5 M3.5,9.5 L2.5,11.5 M9,10.5 L9,12.5 M14.5,9.5 L15.5,11.5"
                                      Stroke="{StaticResource TextPrimaryBrush}" StrokeThickness="1.5" StrokeStartLineCap="Round"
                                      StrokeLineJoin="Round" Fill="Transparent" Visibility="Collapsed"/>
                            </Grid>
                        </Button>
                        <Button x:Name="CollapseButton" Style="{StaticResource GhostIconButton}"
                                Click="OnToggleCollapse" ToolTip="Recolher ferramentas">
                            <Path Data="M5.5,6.5 L8,9 L10.5,6.5" Stroke="{StaticResource TextPrimaryBrush}" StrokeThickness="1.8"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent"/>
                        </Button>
                    </StackPanel>
                </Grid>

                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <StackPanel x:Name="ColorRow" Orientation="Horizontal"/>
                    <Border Style="{StaticResource VSeparator}"/>
                    <Button x:Name="WidthPreset0Button" Content="S" Click="OnWidthPreset0" ToolTip="Espessura fina (1)"
                            Style="{StaticResource GhostIconButton}" FontFamily="{StaticResource UiFontFamily}"/>
                    <Button x:Name="WidthPreset1Button" Content="M" Click="OnWidthPreset1" ToolTip="Espessura média (2)"
                            Style="{StaticResource GhostIconButton}" FontFamily="{StaticResource UiFontFamily}"/>
                    <Button x:Name="WidthPreset2Button" Content="G" Click="OnWidthPreset2" ToolTip="Espessura grossa (3)"
                            Style="{StaticResource GhostIconButton}" FontFamily="{StaticResource UiFontFamily}"/>
                    <Slider x:Name="ThicknessSlider" Minimum="1" Maximum="64" Value="4"
                            Width="110" TickFrequency="1" IsSnapToTickEnabled="True"
                            VerticalAlignment="Center" Foreground="{StaticResource AccentBrush}"
                            ToolTip="Espessura do traço (1–64)"/>
                    <TextBlock x:Name="ThicknessValue" Text="4" Foreground="{StaticResource TextPrimaryBrush}"
                               FontSize="12" Width="22" VerticalAlignment="Center" Margin="4,0,0,0"
                               ToolTip="Espessura atual"/>
                    <Border Style="{StaticResource VSeparator}"/>
                    <Button x:Name="UndoButton" Style="{StaticResource ToolIconButton}" Click="OnUndo" ToolTip="Desfazer (Ctrl+Z)">
                        <Path Data="M7,3.5 L3.5,7 L7,10.5 M3.5,7 H10 C13,7 13,12.5 9,12.5 L6.5,12.5"
                              Stroke="{StaticResource TextPrimaryBrush}" StrokeThickness="1.6" StrokeStartLineCap="Round"
                              StrokeLineJoin="Round" Fill="Transparent"/>
                    </Button>
                    <Button x:Name="RedoButton" Style="{StaticResource ToolIconButton}" Click="OnRedo" ToolTip="Refazer (Ctrl+Y)">
                        <Grid Width="18" Height="18" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform ScaleX="-1"/>
                            </Grid.RenderTransform>
                            <Path Data="M7,3.5 L3.5,7 L7,10.5 M3.5,7 H10 C13,7 13,12.5 9,12.5 L6.5,12.5"
                                  Stroke="{StaticResource TextPrimaryBrush}" StrokeThickness="1.6" StrokeStartLineCap="Round"
                                  StrokeLineJoin="Round" Fill="Transparent"/>
                        </Grid>
                    </Button>
                    <Button x:Name="DeleteObjectButton" Style="{StaticResource ToolIconButton}" Click="OnDeleteScreen"
                             ToolTip="Apagar objeto selecionado (Del)">
                        <Path Data="M4,4.5 H12 M6.5,4.5 V3 H9.5 V4.5 M5,4.5 L5.5,13 H10.5 L11,4.5 M7,6.8 V11 M9,6.8 V11"
                              Stroke="{StaticResource TextPrimaryBrush}" StrokeThickness="1.5" StrokeLineJoin="Round" Fill="Transparent"/>
                    </Button>
                    <Button Style="{StaticResource ToolIconButton}" Click="OnClear" ToolTip="Limpar tudo (C)">
                        <Grid Width="18" Height="18">
                            <Ellipse Width="13" Height="13" Stroke="{StaticResource TextPrimaryBrush}" StrokeThickness="1.5"/>
                            <Path Data="M6,6 L10,10 M10,6 L6,10" Stroke="{StaticResource TextPrimaryBrush}" StrokeThickness="1.5"
                                  StrokeStartLineCap="Round"/>
                        </Grid>
                    </Button>
                    <Border Style="{StaticResource VSeparator}"/>
                    <StackPanel x:Name="FontSlot" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Tamanho" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"
                                   VerticalAlignment="Center" Margin="2,0,6,0"/>
                        <ComboBox x:Name="FontSizeBox" Width="80" VerticalAlignment="Center"
                                  Background="{StaticResource HoverBrush}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12"
                                  ToolTip="Tamanho da fonte: padrão p/ novos textos; aplica ao texto selecionado"/>
                    </StackPanel>
                    <Button Style="{StaticResource PillButtonDanger}" Click="OnExit" Content="Sair" Margin="8,2,2,2"
                            ToolTip="Encerra completamente a aplicação"/>
                </StackPanel>

                <!-- Diagnóstico oculto em produção (botões seguem funcionais p/ debug). -->
                <StackPanel x:Name="DiagnosticsRow" Orientation="Horizontal" Margin="0,4,0,0"
                            Visibility="Collapsed">
                    <Button Style="{StaticResource GhostIconButton}" Click="OnFlash"
                            ToolTip="Diagnóstico: pinta a tela de vermelho por 400ms">
                        <Path Data="M9,1.5 L3.5,9 H7 L6,14.5 L12.5,6.5 H9 Z" Fill="{StaticResource TextSecondaryBrush}"/>
                    </Button>
                    <Button Style="{StaticResource GhostIconButton}" Click="OnWho"
                            ToolTip="Diagnóstico: identifica a janela sob o cursor">
                        <Grid Width="18" Height="18">
                            <Ellipse Width="9" Height="9" Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.5"/>
                            <Path Data="M8,1 V4 M8,14 V17 M1,8 H4 M14,8 H17" Stroke="{StaticResource TextSecondaryBrush}"
                                  StrokeThickness="1.5" StrokeStartLineCap="Round"/>
                        </Grid>
                    </Button>
                    <Button Style="{StaticResource GhostIconButton}" Click="OnFront"
                            ToolTip="Reforça o overlay no topo (z-order)">
                        <Path Data="M8,2.5 L14,6 L8,9.5 L2,6 Z M2.5,9.5 L8,13 L13.5,9.5"
                              Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.4" StrokeLineJoin="Round" Fill="Transparent"/>
                    </Button>
                    <TextBlock x:Name="StatusText" Margin="8,0,0,0" FontFamily="Consolas"
                               FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}" Text="..."
                               VerticalAlignment="Center"/>
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
